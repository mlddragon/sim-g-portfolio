# The 15-minute encrypted database backup, to the 3-day bucket (recovery
# point investigation, section 5; deploy/vm/backup).
[Unit]
Description=SIM-G recent-tier encrypted database backup
# Requisite: a backup never starts PostgreSQL that an operator stopped.
Requires=docker.service sim-g-firewall.service
Requisite=sim-g-postgres.service
After=docker.service sim-g-firewall.service sim-g-postgres.service

[Service]
Type=oneshot
# A hung run is stopped rather than blocking every later one. This signals
# the Docker clients; the containers themselves run outside this cgroup, so
# their cleanup is verified on a real VM (R6).
TimeoutStartSec=5min
# The host settings are read and validated by the wrapper, never loaded
# by systemd.
ExecStart=/bin/bash /etc/sim-g/bin/sim-g-host-env.sh /etc/sim-g/bin/sim-g-backup.sh recent
