# One-shot, started only by the operator (or the deploy step): a fresh
# backup, then forward-only migrations and the runtime grants, never at
# gateway start-up (VM design section 6).
[Unit]
Description=SIM-G database backup, migrations and runtime grants
Requires=docker.service sim-g-firewall.service
Requisite=sim-g-postgres.service
After=docker.service sim-g-firewall.service sim-g-postgres.service

[Service]
Type=oneshot
# The host settings are read and validated by the wrapper, never loaded
# by systemd.
ExecStart=/bin/bash /etc/sim-g/bin/sim-g-host-env.sh /etc/sim-g/bin/sim-g-migrate.sh
