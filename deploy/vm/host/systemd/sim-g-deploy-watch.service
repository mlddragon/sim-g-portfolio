# Follows the deploy pointer (VM design section 10; see the script).
[Unit]
Description=SIM-G deploy-pointer watcher
Requires=docker.service sim-g-firewall.service
After=docker.service sim-g-firewall.service sim-g-postgres.service sim-g-gateway.service

[Service]
Type=oneshot
# A pull is bounded at 10 minutes; a backup, migrations and the health
# check fit in the rest.
TimeoutStartSec=30min
# The host settings are read and validated by the wrapper, never loaded
# by systemd.
ExecStart=/bin/bash /etc/sim-g/bin/sim-g-host-env.sh /etc/sim-g/bin/sim-g-deploy-watch.sh
