{
  "name": "@simg-showcase/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Private authenticated gateway for the Example Knowledge System",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "backup:check": "bash scripts/check-backup-roundtrip.sh",
    "backup:rpo-check": "bash scripts/check-backup-rpo.sh",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "edge:check": "bash scripts/check-edge.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:check": "bash scripts/check-vm-host.sh",
    "image:check": "bash scripts/check-container.sh",
    "infra:check": "bash scripts/check-infrastructure.sh",
    "lint": "eslint . --max-warnings=0",
    "policy:verify": "node --import tsx scripts/verify-policy.ts",
    "start": "node dist/cli.js",
    "test": "vitest run tests/unit tests/contract --passWithNoTests",
    "test:acceptance": "vitest run tests/acceptance --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests --no-file-parallelism",
    "test:unit": "vitest run tests/unit tests/contract --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm policy:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "7.1.1",
    "@googleapis/drive": "22.0.0",
    "@notionhq/client": "5.26.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "fastify": "5.12.2",
    "google-auth-library": "10.5.0",
    "jose": "6.2.15",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
